<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InspectionPipeline.UI.ViewModels"
             xmlns:views="using:InspectionPipeline.UI.Views"
             x:Class="InspectionPipeline.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Catppuccin Mocha Color Palette -->
        <Color x:Key="BackgroundColor">#1E1E2E</Color>
        <Color x:Key="SurfaceColor">#181825</Color>
        <Color x:Key="OverlayColor">#313244</Color>
        <Color x:Key="GreenOKColor">#A6E3A1</Color>
        <Color x:Key="RedNGColor">#F38BA8</Color>
        <Color x:Key="YellowWarnColor">#F9E2AF</Color>
        <Color x:Key="BlueAccentColor">#89B4FA</Color>
        <Color x:Key="TextPrimaryColor">#CDD6F4</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}" />
        <SolidColorBrush x:Key="GreenOK" Color="{StaticResource GreenOKColor}" />
        <SolidColorBrush x:Key="RedNG" Color="{StaticResource RedNGColor}" />
        <SolidColorBrush x:Key="YellowWarn" Color="{StaticResource YellowWarnColor}" />
        <SolidColorBrush x:Key="BlueAccent" Color="{StaticResource BlueAccentColor}" />
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    </Application.Resources>

    <Application.DataTemplates>
        <!-- ViewModel to View mapping for navigation -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:InspectionViewModel}">
            <views:InspectionView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <views:MonitorView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>

</Application>